# ============================================================
# REQUIRED FOUNDATION CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# PRODUCTION HARDENING & SECURITY
# ============================================================
# CORS Allowed Origins (comma-separated list of origins for production cross-origin control)
# CORS_ALLOWED_ORIGINS=https://privacy-auditor.internal,https://admin.privacy-auditor.internal

# Rate Limiting Toggle (set to 'true' in test runs to bypass rate limiting)
# DISABLE_RATE_LIMIT=false

# ============================================================
# ADMINISTRATOR AUTHENTICATION & SECRETS (DEPLOYMENT SECRETS)
# (Configured securely via deployment environment/secrets manager)
# ============================================================
# ADMIN_USERNAME=<set-in-deployment-secrets>
# ADMIN_PASSWORD=<set-in-deployment-secrets>
# ADMIN_SECRET_KEY=<optional-production-secret>

# ============================================================
# OPTIONAL INTEGRATION & PERSISTENCE CONFIGURATION
# ============================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/privacy_auditor
# GEOIP_API_KEY=
# ABUSEIPDB_API_KEY=<optional-server-side-reputation-key>
# SERVER_SECRET_SALT=

# Comma-separated trusted reverse-proxy IPs/CIDRs. Required when requests arrive through a proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Public canonical origin used by Vite index metadata and sitemap generation
VITE_PUBLIC_ORIGIN=https://YOUR_PRODUCTION_DOMAIN

# WebRTC audit STUN endpoints controlled by the operator (comma-separated).
# Leave empty to collect host candidates without contacting a third-party STUN service.
VITE_PRIVASEC_STUN_SERVERS=

# Optional free IPinfo Lite token. Provides country + basic ASN fallback data.
# Public/commercial use requires attribution per IPinfo Lite terms.
IPINFO_TOKEN=
