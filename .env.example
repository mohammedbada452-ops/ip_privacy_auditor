# PrivaSec local development environment.
# Keep real secrets out of source control and deployment logs.
NODE_ENV=development
APP_ENV=development
PORT=3000

# Persistence (required for PostgreSQL-backed production paths)
DATABASE_URL=

# Required secret material for anonymization/authentication
SERVER_SECRET_SALT=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# Optional intelligence providers
IPINFO_TOKEN=
GEOIP_API_KEY=
GEOIP_PROVIDER=
ABUSEIPDB_API_KEY=

# Proxy / network trust configuration (leave empty unless explicitly needed)
TRUSTED_PROXIES=
TRUSTED_PROXY_CIDRS=
TRUST_PROXY=false
TRUST_LOCAL_PROXY=false

# CORS and local/dev controls
CORS_ALLOWED_ORIGINS=http://localhost:3000
DISABLE_RATE_LIMIT=false
PRIVASEC_CLOUDFLARE_EDGE=false
