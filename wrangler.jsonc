{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ip-privacy-auditor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3a000028681445e29a3be843f6f45cb4"
    }
  ]
}
